<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>TempMonitorAgent</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-TempMonitorAgent-54cab2c8-236c-40ae-9704-afc1022ab9bc</UserSecretsId>

    <!-- Windows Service host -->
    <OutputType>Exe</OutputType>
    <AssemblyName>TempMonitorAgent</AssemblyName>

    <!-- WinForms is here for exactly one screen: the attended-consent prompt the remote helper
         shows on the end user's desktop (Remote/ConsentDialog.cs). The service itself stays
         headless; no window is ever created outside that prompt. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The SDK's generated Main/ApplicationConfiguration is for WinForms apps; this is a
         Worker with its own Program.cs, and the dialog initialises visual styles itself. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>

    <!-- Release/publish defaults (self-contained single-file win-x64 so the
         fleet needs no .NET runtime install). Override on the CLI as needed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Assembly version drives the self-update version comparison. Keep in
         sync with AgentConfig.Version. -->
    <Version>3.21.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms makes System.Windows.Forms an implicit global using, which collides
         with our own names (Fleet's ICommandExecutor, System.Threading.Timer) across the whole
         headless codebase. Only ConsentDialog.cs wants those types, and it imports them itself. -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.6" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.4" />
    <!-- 2.6.2 floor is SIPSorcery's (below); the Ed25519 API we use for self-update
         verification is unchanged from 2.5.1. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- SignedCms, for reading the signer chain out of a driver's .cat (a PKCS#7 envelope)
         before we make the machine trust that publisher. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- Remote view/control (roadmap #2). DXGI Desktop Duplication + a Media Foundation H.264
         encoder for screen capture; SIPSorcery for the WebRTC transport. All managed wrappers
         over in-box Windows DLLs (d3d11/dxgi/mfplat) or pure managed (SIPSorcery), so the
         self-contained single-file publish is unaffected. -->
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <PackageReference Include="SIPSorcery" Version="10.0.12" />
    <!-- VP8 fallback codec. Media Foundation has no in-box VP8 encoder, so this wraps libvpx
         (a native DLL, which IncludeNativeLibrariesForSelfExtract above carries into the
         single-file publish). H.264 stays the default: VP8 is software-only and costs
         noticeably more CPU. It exists for a browser or middlebox that mishandles our H.264. -->
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- TarGzipPipe is an implementation detail of the backup executor, but the archive
         it produces has to be readable by stdlib tar (that is what keeps a machine backup
         restorable with no hub) - so it is tested directly rather than widened to public. -->
    <InternalsVisibleTo Include="TempMonitorAgent.Tests" />
  </ItemGroup>

</Project>
