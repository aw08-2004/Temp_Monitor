flutter_sdk

# Private signing key for agent self-updates -- MUST never be committed.
.temp_monitor_signing_key
*.temp_monitor_signing_key

# Android release signing keystore -- MUST never be committed, and MUST never be lost.
# Losing it means no installed agent can be updated in place, and every device's SSAID
# changes, so the whole Android fleet re-appears as new machines. Keep it with
# BACKUP_MASTER_KEY. See agent-android/README.md.
*.keystore
*.jks
agent-android/signing.props

