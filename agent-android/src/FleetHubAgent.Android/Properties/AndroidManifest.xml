<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- **Permissions and application-level settings only. No components.**
       .NET Android generates the <activity>, <service> and <receiver> elements from the
       [Activity], [Service] and [BroadcastReceiver] attributes on the classes themselves, and
       merges them into this file at build time. Declaring a component in both places produces
       TWO entries for it: the hand-written one names a class that does not exist under that
       name, because the generated wrapper is what Android actually loads. So the rule here is:
       anything about a component lives on the component, and this file holds what has no class
       to live on. -->

  <!-- The agent talks to the hub over HTTPS and does nothing else on the network. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

  <!-- The agent must keep running with no screen on and nobody looking at it, which on
       Android means one thing: a foreground service with a visible notification. There is no
       quieter option. WorkManager's floor is fifteen minutes, JobScheduler's is longer under
       Doze, and both would put a machine well outside the hub's 90 second online window. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <!-- Both service types, because which one the service starts with depends on the API level
       it finds itself on (see AgentService.ForegroundType). Android refuses to start a
       foreground service with a type its manifest does not declare, so shipping only the
       preferred one would crash the service on every device below API 34. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

  <!-- Android 13+ will not show the service's notification without this being granted at
       runtime. The service still RUNS without it, so this is not fatal; what is lost is the
       only status display the agent has. See MainActivity. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- A managed device reboots (an update, a flat battery) and nobody is there to reopen an
       app. Without this the machine simply never comes back in the console. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Deliberately NOT requested, and each absence is a decision:
         READ_PHONE_STATE       would not help. The hardware serial needs
                                READ_PRIVILEGED_PHONE_STATE, which is signature-level and
                                available only to system apps, so a normal build cannot read
                                one at any permission level. See AndroidSystemInfo.
         ACCESS_FINE_LOCATION   the console has no map and the fleet has no use for one. A
                                fleet agent that asks for location is an agent nobody installs.
         QUERY_ALL_PACKAGES     an inventory of installed apps is a Play policy problem and
                                answers a question nothing in the console asks yet.
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
                                the app sends the operator to the system's own battery screen
                                instead (MainActivity.OpenBatterySettings). Holding the
                                permission lets an app raise the exemption dialog directly,
                                which Play treats as a policy violation for most apps and
                                which several OEM power managers ignore anyway. -->

  <application android:label="FleetHub Agent"
               android:allowBackup="false"
               android:usesCleartextTraffic="false">

    <!-- allowBackup="false" is load-bearing. Android's automatic cloud backup would carry this
         app's SharedPreferences to a NEW device on restore, and with them the enrollment
         identity: two devices would then hold one machine's bearer token and report as the
         same machine, which is the duplicate this agent works hardest to avoid. It would also
         put the fleet's shared enrollment secret into a Google account backup. -->

    <!-- usesCleartextTraffic="false": the agent speaks to one hub over TLS and nothing else.
         AgentConfig.Configure will accept an http:// URL because a lab hub on a workbench is a
         real case, and on a release build the platform refuses the connection anyway, which
         is the right order of events: the agent does not pretend to protect the operator from
         a URL they typed, the platform does. -->

    <!-- Where an MDM's managed configuration is declared. The keys are read in ManagedConfig;
         this restrictions file is what makes them appear as fields in the MDM's own console,
         so an administrator can fill them in without touching the device. -->
    <meta-data android:name="android.content.APP_RESTRICTIONS"
               android:resource="@xml/app_restrictions" />
  </application>
</manifest>
