<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- No RuntimeIdentifier to clear and no CA1416 to suppress, unlike the Linux agent's test
         project. Both of those exist there because the agent assembly is platform-pinned; the
         whole point of FleetHubAgent.Core is that it is not, so this is an ordinary net10.0
         test project referencing an ordinary net10.0 library.

         The Android half (src/FleetHubAgent.Android) is deliberately NOT referenced here and
         must not be: it needs the Android workload to restore and a device or emulator to run
         a test on, so referencing it would turn `dotnet test` from something anyone in this
         shop can run into something only a machine with the SDK can. What that costs is
         stated plainly in agent-android/README.md rather than hidden. -->

    <!-- **Reflection-based System.Text.Json is OFF in this test run, because it is off on the
         phone.** The Release APK is trimmed fully (AndroidLinkMode=full), and a trimmed app
         ships System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault=false: every
         JsonSerializer call without a source-generated JsonTypeInfo throws
         InvalidOperationException on the device and works perfectly here. That gap let 0.2.1
         ship an agent that could not store its own enrollment token: SaveIdentity caught the
         throw and returned false, so every enrollment was discarded and retried forever, on
         QR and setup screen alike, while all 93 tests passed. Turning it off here is what
         makes a workstation run fail the way a device does. See JsonTrimmingTests. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FleetHubAgent.Core\FleetHubAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
